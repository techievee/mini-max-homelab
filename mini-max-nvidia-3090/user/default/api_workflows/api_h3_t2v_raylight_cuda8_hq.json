  "vae_a": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "cond": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae_v",
        0
      ],
      "prompt": "Cinematic live-action shot: a red vintage motorcycle rides along a wet coastal road at sunset, waves crashing against black rocks, warm golden backlight, light rain, shallow depth of field. The camera tracks alongside, then rises to reveal the coastline and the sun touching the horizon. Sound: engine rumble, waves, light rain on asphalt.",
      "width": 1344,
      "height": 768,
      "length": 362
    }
  },
  "guider": {
    "class_type": "RayBasicGuider",
    "inputs": {
      "ray_actors": [
        "unet",
        0
      ],
      "conditioning": [
        "cond",
        0
      ]
    }
  },
  "sched": {
    "class_type": "RayBasicScheduler",
    "inputs": {
      "ray_actors": [
        "unet",
        0
      ],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "sample": {
    "class_type": "XFuserSamplerCustomAdvanced",
    "inputs": {
      "add_noise": true,
      "noise_seed": 1087809629367117,
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sched",
        0
      ],
      "latent_image": [
        "cond",
        1
      ]
    }
  },
  "dec_v": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "vae_v",
        0
      ]
    }
  },
  "dec_a": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "vae_a",
        0
      ]
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "dec_v",
        0
      ],
      "audio": [
        "dec_a",
        0
      ],
      "fps": 24
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "video/MiniMax_H3_raylight_cuda8_hq",
      "format": "auto",
      "codec": "auto"
    }
