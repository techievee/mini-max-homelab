{
  "ray": {
    "class_type": "RayInitializerAdvanced",
    "inputs": {
      "ray_cluster_address": "local",
      "ray_cluster_namespace": "default",
      "GPU": 8,
      "GPU_SELECT": "",
      "ulysses_degree": 8,
      "ring_degree": 1,
      "clear_vram_after_sampling": true,
      "cfg_degree": 1,
      "dp_degree": 1,
      "sync_ulysses": false,
      "FSDP": true,
      "FSDP_CPU_OFFLOAD": false,
      "XFuser_attention": "SAGE_FP16",
      "skip_comm_test": false,
      "use_mmap": true,
      "ray_object_store_gb": 32.0
    }
  },
  "unet": {
    "class_type": "RayUNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_bf16.safetensors",
      "weight_dtype": "default",
      "ray_actors_init": [
        "ray",
        0
      ]
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_bf16.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "vae_v": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
